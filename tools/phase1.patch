diff --git a/swift/Boxer0/Boxer0/CombatTuning.swift b/swift/Boxer0/Boxer0/CombatTuning.swift
new file mode 100644
index 0000000..97665d4
--- /dev/null
+++ b/swift/Boxer0/Boxer0/CombatTuning.swift
@@ -0,0 +1,59 @@
+import Foundation
+
+/// Single home for combat numbers. Placeholder values for feel-testing.
+/// Phase 1: defined only; nothing reads these yet. Times are in seconds.
+struct CombatTuning {
+    // Match
+    var rounds = 8
+    var roundSeconds = 120.0
+
+    // Fighter caps
+    var maxStamina = 100.0
+    var maxHealth = 100.0
+    var maxAwareness = 100.0
+    var loseHealthBelow = 40.0
+    var roundStartHealthRegen = 10.0
+
+    // Timing
+    var attackCooldown = 1.0
+    var defenseActivation = 0.5
+    var baseReaction = 0.05
+    var maxReaction = 0.6
+    var grabHoldMax = 3.0
+    var consecutiveHeadHitReset = 3.0   // assumption: streak expires after this long
+
+    // Awareness
+    var consecutiveGrowth = 1.2
+    var unguardedFraction = 1.0 / 3.0
+    var heavyUnguardedFraction = 1.0 / 2.0
+    var withdrawDropFactor = 0.5
+
+    // Health damage (used from phase 2)
+    var bodyHealthDamage = 3.0
+    var headHealthDamage = 4.0
+    var consecutiveHeadDamage = 10.0
+
+    // Stamina
+    var guardCostPercent = 5.0
+    var swayCost = 0.0
+    var regenIdle = 8.0, regenGrab = 5.0, regenWithdraw = 12.0   // per second
+    var grabStaminaBelow = 50.0
+
+    // Points
+    var headPoints = 3, bodyPoints = 1, guardedPoints = 1
+
+    // CPU
+    var defendInWindow = 0.5
+    var defendAfterHit = 0.9
+    var idleGuardDropAfter = 3.0
+    var idleGuardDropChance = 0.5
+
+    func levelMultiplier(attacker: Int, defender: Int) -> Double {
+        Double(attacker + 1) / Double(defender + 1)
+    }
+}
+
+/// Per-fighter level holder. Level stats are injected later; both fighters are level 1.
+struct FighterStats {
+    var level = 1
+}
diff --git a/swift/Boxer0/Boxer0/FighterMeters.swift b/swift/Boxer0/Boxer0/FighterMeters.swift
new file mode 100644
index 0000000..a57bd31
--- /dev/null
+++ b/swift/Boxer0/Boxer0/FighterMeters.swift
@@ -0,0 +1,79 @@
+import Foundation
+
+enum HitZone { case head, body }
+enum RegenMode { case guarding, idle, grab, withdraw }
+
+/// Stamina and awareness for one fighter. Pure value type, not yet wired into the scene.
+/// Awareness 0 is a knockout. Consecutive-hit escalation applies to unguarded head hits only.
+struct FighterMeters {
+    let tuning: CombatTuning
+    private(set) var stamina: Double
+    private(set) var awareness: Double
+    private(set) var consecutiveHeadHits = 0
+    private var sinceHeadHit = 0.0
+
+    init(tuning: CombatTuning = CombatTuning()) {
+        self.tuning = tuning
+        stamina = tuning.maxStamina
+        awareness = tuning.maxAwareness
+    }
+
+    var isKnockedOut: Bool { awareness <= 0 }
+
+    /// Grab needs low stamina and the too-close distance state.
+    func canStartGrab(isTooClose: Bool) -> Bool {
+        isTooClose && stamina < tuning.grabStaminaBelow
+    }
+
+    /// Returns the awareness dropped. A guarded hit costs stamina only.
+    @discardableResult
+    mutating func receiveHit(zone: HitZone, guarded: Bool, heavy: Bool = false,
+                             withdrawing: Bool = false, levelMultiplier: Double = 1) -> Double {
+        if guarded {
+            let cost = tuning.maxStamina * tuning.guardCostPercent / 100 * levelMultiplier
+            stamina = max(0, stamina - cost)
+            return 0
+        }
+        var n = 1
+        if zone == .head {
+            consecutiveHeadHits += 1
+            sinceHeadHit = 0
+            n = consecutiveHeadHits
+        }
+        let fraction = heavy ? tuning.heavyUnguardedFraction : tuning.unguardedFraction
+        var drop = tuning.maxAwareness * fraction * pow(tuning.consecutiveGrowth, Double(n - 1))
+        if withdrawing { drop *= tuning.withdrawDropFactor }
+        let before = awareness
+        awareness = max(0, awareness - drop)
+        return before - awareness
+    }
+
+    /// Call when a defense succeeds (sway, withdraw, block) to end a head-hit streak.
+    mutating func endHeadHitStreak() { consecutiveHeadHits = 0; sinceHeadHit = 0 }
+
+    mutating func spendSway() { stamina = max(0, stamina - tuning.swayCost) }
+
+    mutating func advance(_ dt: Double, mode: RegenMode) {
+        guard dt.isFinite, dt > 0 else { return }
+        if consecutiveHeadHits > 0 {
+            sinceHeadHit += dt
+            if sinceHeadHit >= tuning.consecutiveHeadHitReset { endHeadHitStreak() }
+        }
+        switch mode {
+        case .guarding: break
+        case .idle: stamina = min(tuning.maxStamina, stamina + tuning.regenIdle * dt)
+        case .grab: stamina = min(tuning.maxStamina, stamina + tuning.regenGrab * dt)
+        case .withdraw:
+            stamina = min(tuning.maxStamina, stamina + tuning.regenWithdraw * dt)
+            awareness = min(tuning.maxAwareness, awareness + tuning.regenWithdraw * dt)
+        }
+    }
+
+    /// Awareness-driven delay: baseReaction at full awareness, slower as it drops.
+    /// Also usable as the attack lockout. Clamped to maxReaction.
+    var reactionDelay: Double {
+        guard awareness > 0 else { return tuning.maxReaction }
+        return min(tuning.maxReaction,
+                   tuning.baseReaction * tuning.maxAwareness / awareness)
+    }
+}
diff --git a/swift/Boxer0/Boxer0Tests/FighterMetersTests.swift b/swift/Boxer0/Boxer0Tests/FighterMetersTests.swift
new file mode 100644
index 0000000..d9eb21c
--- /dev/null
+++ b/swift/Boxer0/Boxer0Tests/FighterMetersTests.swift
@@ -0,0 +1,69 @@
+import XCTest
+@testable import Boxer0
+
+final class FighterMetersTests: XCTestCase {
+    func testThreeConsecutiveUnguardedHeadHitsKnockOut() {
+        var m = FighterMeters()
+        XCTAssertEqual(m.receiveHit(zone: .head, guarded: false), 100.0 / 3.0, accuracy: 1e-9)
+        XCTAssertEqual(m.receiveHit(zone: .head, guarded: false), 40.0, accuracy: 1e-9)
+        XCTAssertFalse(m.isKnockedOut)
+        m.receiveHit(zone: .head, guarded: false)
+        XCTAssertTrue(m.isKnockedOut)
+    }
+
+    func testBodyHitsDoNotEscalate() {
+        var m = FighterMeters()
+        let a = m.receiveHit(zone: .body, guarded: false)
+        let b = m.receiveHit(zone: .body, guarded: false)
+        XCTAssertEqual(a, b, accuracy: 1e-9)
+        XCTAssertEqual(m.consecutiveHeadHits, 0)
+    }
+
+    func testHeavyAndWithdrawFactors() {
+        var heavy = FighterMeters()
+        XCTAssertEqual(heavy.receiveHit(zone: .body, guarded: false, heavy: true), 50, accuracy: 1e-9)
+        var away = FighterMeters()
+        XCTAssertEqual(away.receiveHit(zone: .body, guarded: false, withdrawing: true), 100.0 / 6.0, accuracy: 1e-9)
+    }
+
+    func testGuardedHitCostsStaminaOnly() {
+        var m = FighterMeters()
+        XCTAssertEqual(m.receiveHit(zone: .head, guarded: true), 0)
+        XCTAssertEqual(m.stamina, 95, accuracy: 1e-9)
+        XCTAssertEqual(m.awareness, 100)
+    }
+
+    func testGrabGate() {
+        var m = FighterMeters()
+        XCTAssertFalse(m.canStartGrab(isTooClose: true))
+        for _ in 0..<10 { m.receiveHit(zone: .head, guarded: true, levelMultiplier: 2) }
+        XCTAssertLessThan(m.stamina, 50)
+        XCTAssertTrue(m.canStartGrab(isTooClose: true))
+        XCTAssertFalse(m.canStartGrab(isTooClose: false))
+    }
+
+    func testRegenAndClamp() {
+        var m = FighterMeters()
+        m.receiveHit(zone: .head, guarded: false)
+        m.advance(1, mode: .guarding)
+        XCTAssertEqual(m.awareness, 100.0 - 100.0 / 3.0, accuracy: 1e-9)
+        m.advance(10, mode: .withdraw)
+        XCTAssertEqual(m.awareness, 100, accuracy: 1e-9)
+        XCTAssertEqual(m.stamina, 100, accuracy: 1e-9)
+    }
+
+    func testHeadHitStreakExpires() {
+        var m = FighterMeters()
+        m.receiveHit(zone: .head, guarded: false)
+        m.advance(3.1, mode: .idle)
+        XCTAssertEqual(m.consecutiveHeadHits, 0)
+    }
+
+    func testReactionDelayScalesWithAwareness() {
+        var m = FighterMeters()
+        XCTAssertEqual(m.reactionDelay, 0.05, accuracy: 1e-9)
+        m.receiveHit(zone: .body, guarded: false)
+        XCTAssertGreaterThan(m.reactionDelay, 0.05)
+        XCTAssertLessThanOrEqual(m.reactionDelay, 0.6)
+    }
+}
